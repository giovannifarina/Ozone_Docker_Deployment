FROM apache/ozone:2.2.1 AS ozone-dist

FROM python:3.11-slim

# Install system dependencies and JRE for Ozone CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# Copy Ozone binaries, libraries and log4j configuration from official image
COPY --from=ozone-dist /opt/hadoop /opt/hadoop

# Configure PATH, JAVA_HOME, and Hadoop/Ozone config directory
ENV JAVA_HOME="/usr/lib/jvm/default-java"
ENV PATH="/opt/hadoop/bin:${PATH}"
ENV OZONE_CONF_DIR="/etc/hadoop"

# Create /etc/hadoop configuration pointing to the Ozone cluster services
RUN mkdir -p /etc/hadoop && \
    cp /opt/hadoop/etc/hadoop/log4j.properties /etc/hadoop/ 2>/dev/null || true && \
    echo '<configuration>\n\
<property><name>ozone.om.address</name><value>om</value></property>\n\
<property><name>ozone.om.http-address</name><value>om:9874</value></property>\n\
<property><name>ozone.scm.names</name><value>scm</value></property>\n\
<property><name>ozone.scm.client.address</name><value>scm</value></property>\n\
<property><name>ozone.replication</name><value>1</value></property>\n\
<property><name>ozone.server.default.replication</name><value>1</value></property>\n\
</configuration>' > /etc/hadoop/ozone-site.xml

# Install Python packages for Jupyter, data manipulation and benchmarking
RUN pip install --no-cache-dir \
    jupyterlab \
    notebook \
    boto3 \
    botocore \
    requests \
    tqdm \
    pandas

WORKDIR /workspace

EXPOSE 8888

# Launch JupyterLab directly
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--ServerApp.token=''", "--ServerApp.password=''", "--ServerApp.allow_origin='*'"]
